# ============================================================
# Environment Variables - CP Stroke Non Perdarahan
# ============================================================
# Copy file ini ke .env (untuk dev lokal) atau set di Vercel
# dashboard (untuk production).
# ============================================================

# --- Database ---
# DEV LOKAL (SQLite, file-based):
DATABASE_URL="file:./db/custom.db"

# PRODUCTION (Vercel + Neon Postgres):
# Dapatkan URL ini dari https://neon.tech setelah membuat database gratis
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/cp_stroke?sslmode=require"

# --- Admin PIN ---
# PIN untuk mengakses halaman admin (data submissions)
# Default: 1234 — GANTI ke PIN yang kuat sebelum production!
ADMIN_PIN="1234"

# --- Next.js ---
# Tetap default, tidak perlu diubah
NEXT_PUBLIC_APP_NAME="CP Stroke RSUD Dr. Soedarso"
